{
  "name": "oneshot-strands-agents-e2e",
  "version": "1.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.13.0",
    "npm": ">=11.8.0"
  },
  "scripts": {
    "oneshot": "node scripts/oneshot.mjs",
    "dev": "node --env-file=app/env/.env dist/backend/index.js",
    "dev:worker": "node --env-file=app/env/.env dist/backend/scripts/run-pipeline-worker.js",
    "agent:review": "npm run build:backend && node dist/app/bootstrap/readme.js",
    "build": "tsc -p tsconfig.json && npm --prefix app/web run build",
    "start": "node dist/backend/index.js",
    "test": "npm run build:backend && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-force-exit dist/backend/tests/ts/*.test.js",
    "build:test": "tsc -p tsconfig.test.json",
    "demo": "node app/bootstrap/demo.mjs",
    "setup": "node -e \"require('child_process').execSync(process.platform==='win32'?'app/bootstrap/setup.bat':'bash app/bootstrap/setup.sh',{stdio:'inherit'})\"",
    "verify": "python app/scripts/verify_all.py",
    "build:backend": "tsc -p tsconfig.json",
    "build:ui": "npm --prefix app/web run build",
    "judge": "node scripts/judge.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "guard:layout": "node scripts/guard/layout.mjs",
    "guard:layout:enforce": "node scripts/guard/layout.mjs --enforce",
    "redis:up": "docker compose -f docker/docker-compose.dev.yml up -d redis",
    "redis:down": "docker compose -f docker/docker-compose.dev.yml down",
    "redis:logs": "docker compose -f docker/docker-compose.dev.yml logs -f redis",
    "dev:up": "docker compose -f docker/docker-compose.dev.yml up --build -d",
    "dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "start:worker": "node dist/backend/scripts/run-pipeline-worker.js",
    "test:pipeline:e2e": "node backend/scripts/test-pipeline-e2e.mjs",
    "test:ui:walkthrough": "node scripts/e2e/browser/strands-ui-walkthrough.mjs",
    "test:pipeline:recovery": "node backend/scripts/test-pipeline-recovery.mjs",
    "test:pipeline:checkpoint-recovery": "node backend/scripts/test-pipeline-checkpoint-recovery.mjs",
    "test:pipeline:refinement-recovery": "node backend/scripts/test-pipeline-refinement-recovery.mjs"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.17.0",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "adm-zip": "^0.6.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "file:app/vendor/npm/types-node-24.0.4.tgz",
    "typescript": "file:app/vendor/npm/typescript-5.8.3.tgz",
    "undici-types": "file:app/vendor/npm/undici-types-7.8.0.tgz"
  }
}
